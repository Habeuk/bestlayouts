 {# /** * @file * Bootstrap Barrio's override to display a menu. * *
Available variables: * - menu_name: The machine name of the menu. * -
items: A nested list of menu items. Each menu item contains: * -
attributes: HTML attributes for the menu item. * - below: The menu item
child items. * - title: The menu link title. * - url: The menu link url,
instance of \Drupal\Core\Url * - localized_options: Menu link localized
options. * - is_expanded: TRUE if the link has visible children within
the current * menu tree. * - is_collapsed: TRUE if the link has children
within the current menu tree * that are not currently visible. * -
in_active_trail: TRUE if the link is in the active trail. */ #} {# We
call a macro which calls itself to render the full tree. @see
http://twig.sensiolabs.org/doc/tags/macro.html #}
{% macro menu_links(items, attributes, menu_level, show_icone_home, btly_megamenus_layout=false) %}
    {% if items %}
        {% if btly_megamenus_layout and menu_level >= 1 %}
            <div class="megaslayout d-flex flex-wrap">
            	{% endif %}
            	<ul {% if menu_level == 0 %} {{attributes.addClass(['hbk-mega-menu--items','megas' ])}} {% else %} class="hbk-mega-menu--items__sub level_{{ menu_level }}" {% endif %}>
            		{% for item in items %}
                		{% set classes = [] %}
                		<li {{item.attributes.addClass(classes)}}>{% set link_classes = ['item-link'] %}
                			{% if item.below %} {{ link(item.title, item.url, {'class': link_classes, 'data-toggle': 'dropdown', 'aria-expanded': 'false', 'aria-haspopup': 'true' }) }}
                			{% set var__btly_megamenus_layout= false %} {% if item.btly_megamenus_layout %}
                			{% set var__btly_megamenus_layout= item.btly_megamenus_layout %} {% endif %}
                			{{ _self.menu_links(item.below, attributes, menu_level + 1, show_icone_home, var__btly_megamenus_layout) }}
                			{% else %} {{ link(item.title, item.url, {'class': link_classes}) }}
                			{% if item.btly_megamenus_layout %}
                			<div class="megaslayout d-flex">
                				{{ item.btly_megamenus_layout }}
                			</div> {% endif %} {% endif %}
                		</li>
            		{% endfor %}
            	</ul>
            	{% if btly_megamenus_layout and menu_level >= 1 %}
            	{{ btly_megamenus_layout }}
            </div>
        {% endif %}
    {% endif %}
{% endmacro %}
{{ _self.menu_links(items, attributes, 0, show_icone_home) }}

